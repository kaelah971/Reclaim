# Celo Sepolia Testnet (replaces Alfajores)
# The network is fixed in code to Celo Sepolia (chain ID 11142220).
# See src/lib/web3/chains.ts — there is no chain-ID environment override.
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_EXPLORER_URL=https://celo-sepolia.blockscout.com

# Payment token (Circle USDC on Celo Sepolia)
# Product copy uses "cUSD" / "dollar stablecoin on Celo" for marketing.
# Wallet transactions will show the on-chain symbol "USDC".
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E
NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=6

# Escrow contract (deployed during I2 / I6B.2)
# V2 (current): 0x1A1CA38D6ac538d491A5c0db2Ed7FDDC3AeC709F — supports resolveDispute
# V1 (historical): 0x0fA826256a58F19Ad24Fc9384d81D313f2266F79 — no dispute resolution
# Optional override; the canonical V2 address is the code fallback.
NEXT_PUBLIC_PROTECTED_PAYMENT_ESCROW_ADDRESS=

# Celo Builders attribution tag (assigned by the Celo team; leave empty until assigned).
# When unset, transactions are sent without an attribution data suffix.
NEXT_PUBLIC_CELO_ATTRIBUTION_TAG=

# Development-only: shows wallet-chain diagnostics in the connected wallet menu. Never enable in production.
NEXT_PUBLIC_CHAIN_DIAGNOSTICS_ENABLED=false

# ---------------------------------------------------------------------------
# x402 payment configuration (CRITICAL — read carefully)
# ---------------------------------------------------------------------------

# x402 service-revenue wallet (public Reclaim wallet for Celo Builders hackathon)
# This wallet receives x402 service fees — it MUST NOT be the escrow contract.
# The x402 fee is SEPARATE from escrow funds:
#   - Escrow: holds protected funds for buyer/worker disputes
#   - x402 payTo: receives micro-fees for services like dispute brief generation
#
# REQUIRED for live on-chain settlement. Without this, the server will return
# 500 "x402 payment processing is not configured."
#
# The server validates at startup that this address:
#   - Is a valid 0x-prefixed hex address
#   - Is NOT the escrow contract (0x0fA826256a58F19Ad24Fc9384d81D313f2266F79)
NEXT_PUBLIC_X402_PAY_TO_ADDRESS=
X402_PAY_TO_ADDRESS=

# x402 settlement relayer — dedicated gas wallet for submitting Permit2
# transfer transactions on-chain.
#
# This is NOT the deployer key. It is a dedicated wallet that ONLY pays Celo
# gas fees to execute Permit2 transfers. It never holds user funds or escrow
# tokens. The buyer authorizes the USDC transfer via Permit2 signature; the
# relayer submits the on-chain transaction that moves the USDC from buyer to
# the service wallet.
#
# Format: 64-character hex private key, with or without 0x prefix.
#
# REQUIRED for server-side settlement. If unset, settlement will fail with
# "X402_RELAYER_PRIVATE_KEY is not configured."
#
# IMPORTANT: Never commit this value to version control. Keep it in .env.local
# only and use a dedicated testnet wallet with minimal CELO for gas.
X402_RELAYER_PRIVATE_KEY=

# Dispute brief price in USDC (smallest reliable testnet amount)
NEXT_PUBLIC_X402_DISPUTE_BRIEF_PRICE=0.01
X402_DISPUTE_BRIEF_PRICE=0.01

# Pre-computed atomic price override (optional — computed from above if unset)
# Atomic units = price × 10^decimals. USDC has 6 decimals, so 0.01 = 10000.
# X402_DISPUTE_BRIEF_PRICE_ATOMIC=10000

# Optional override for USDC address and decimals (normally from token config)
# X402_USDC_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E
# X402_USDC_DECIMALS=6

# ===========================================================================
# x402 settlement mode (T2.1 — Celo Track 2 integration)
# ===========================================================================
#
# "local" (default):
#   - Self-settles via Permit2 + local relayer on Celo Sepolia
#   - Uses X402_RELAYER_PRIVATE_KEY for on-chain settlement
#   - Development / non-Track-2 mode
#
# "celo-facilitator":
#   - Delegates verification & settlement to https://api.x402.celo.org
#   - Celo MAINNET (eip155:42220) — the ONLY supported facilitator network
#   - Track 2 qualifying (Most x402 Payments)
#   - Facilitator broadcasts settlement; X402_RELAYER_PRIVATE_KEY is unused
#   - NEVER silently falls back to local settlement
#   - payTo address locked to Track 2 registered wallet
#
# X402_SETTLEMENT_MODE=local

# Track 2 payTo wallet (Celo mainnet) — used in celo-facilitator mode
# This is the registered Reclaim Track 2 receiving wallet.
# Override only for testing; production Track 2 must use the canonical address.
# X402_PAY_TO_ADDRESS_FACILITATOR=0x85522bdE267d05bf8CE8813F97c75417b7894A33

# Reclaim's assigned Celo Builders attribution tag
# (celo_b7de8bf7e64e — registered during hackathon signup)
# Not injected into facilitator transactions; used for Reclaim-originated
# eligible Celo transactions where attribution tagging is appropriate.
NEXT_PUBLIC_CELO_ATTRIBUTION_TAG=celo_b7de8bf7e64e

# x402 Celo facilitator URL — used for cryptographic payment verification
# (verify endpoint) and settlement via the official facilitator API.
NEXT_PUBLIC_X402_FACILITATOR_URL=https://x402.celo.org

# Optional: WalletConnect
# WalletConnect is hidden from the UI when this is not set.
# Enabling it also requires installing the optional peer dependency:
#   npm install @walletconnect/ethereum-provider
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Supabase — durable x402 payment persistence (I4)
# ---------------------------------------------------------------------------
# Server-only secret key for payment store operations.
# These must NEVER be exposed to the browser.
#
# When unset, the system falls back to in-memory storage (not durable).
# When set, all x402 payment records are persisted in PostgreSQL via Supabase.
#
# To set up:
#   1. Create a Supabase project at https://supabase.com
#   2. Copy the project URL from Settings > API > Project URL
#   3. Copy the secret key from Settings > API > secret (sb_secret_...)
#      — the legacy service_role JWT (eyJ...) is also supported via
#        SUPABASE_SERVICE_ROLE_KEY for compatibility
#   4. Run the migration SQL in the Supabase SQL Editor
#   5. Seed the legacy settlement: node scripts/migrate-legacy-settlement.mjs
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy: SUPABASE_SERVICE_ROLE_KEY is still read as a fallback
# SUPABASE_SERVICE_ROLE_KEY=

# Optional public Supabase credentials (only needed if browser clients are added later)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# AI dispute case brief generation (I5) — server-only
# ---------------------------------------------------------------------------
# AI_PROVIDER — which provider to use:
#   "deepseek" (recommended for Reclaim), "openai", or "anthropic"
# AI_MODEL — model identifier (defaults to "deepseek-v4-pro")
# AI_API_KEY — provider API key (NEVER expose via NEXT_PUBLIC)
# When unset, deterministic fallback is used automatically.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-pro
AI_API_KEY=

# ---------------------------------------------------------------------------
# Reviewer authorization (I6A) — server-only
# ---------------------------------------------------------------------------
# Comma-separated EVM addresses authorized to review disputes.
REVIEWER_ALLOWLIST=

# ---------------------------------------------------------------------------
# Dispute resolution execution (I6B) — server-only
# ---------------------------------------------------------------------------
# Private key of the wallet authorized to call resolveDispute on-chain.
# Must be the contract owner (deployer wallet or transferred ownership).
# NEVER prefix with NEXT_PUBLIC. NEVER commit to version control.
# When unset, execution runs in dry-run mode (validates but does not broadcast).
ESCROW_EXECUTOR_PRIVATE_KEY=

# Set to "true" for dry-run mode — full validation, no transaction broadcast.
# Recommended for initial deployment verification. Defaults to true if
# ESCROW_EXECUTOR_PRIVATE_KEY is unset.
# ESCROW_EXECUTION_DRY_RUN=true

# ---------------------------------------------------------------------------
# Resolution Agent — server-only
# ---------------------------------------------------------------------------
# AES-256-GCM encryption key for case-wallet private-key encryption.
# Must be a base64-encoded 32-byte random value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER prefix with NEXT_PUBLIC. NEVER commit a real key to version control.
# When unset, wallet generation and encryption will fail with a configuration error.
RESOLUTION_AGENT_WALLET_ENCRYPTION_KEY=

